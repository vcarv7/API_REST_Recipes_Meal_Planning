# Django core
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=

# Base de datos via URL (la lee decouple + dj-database-url)
# Ejemplos: sqlite:///db.sqlite3  |  postgres://usuario:clave@host:5432/base
DATABASE_URL=

# Email (usado por config.settings.produccion; en local el correo va a consola)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=

# Produccion / PaaS: origen(es) HTTPS confiables para CSRF (ej. https://tu-app.up.railway.app)
CSRF_TRUSTED_ORIGINS=

# Rate limiting (opcionales: descomenta y ajusta; los defaults viven en settings)
# THROTTLE_ANON_RATE=1000/day
# THROTTLE_USER_RATE=10000/day
# THROTTLE_LOGIN_RATE=10/min
# THROTTLE_REGISTER_RATE=10/hour